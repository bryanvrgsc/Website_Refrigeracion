---
import { Image } from "astro:assets";

const supplierLogos = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/images/suppliers/*.avif",
  { eager: true },
);
const getLogo = (name: string) =>
  supplierLogos[`/src/assets/images/suppliers/${name}`].default;

const suppliers = [
  {
    name: "Comercial de Aire Acondicionado",
    logo: getLogo("Comercial de Aire Acondicionado.avif"),
  },
  {
    name: "Confort Excellence",
    logo: getLogo("ConfortExcellence.avif"),
  },
  { name: "Dimaco Equipos", logo: getLogo("Dimaco Equipos.avif") },
  {
    name: "Empaques Industriales",
    logo: getLogo("Empaques Industriales.avif"),
  },
  { name: "ER Comsa", logo: getLogo("ER Comsa.avif") },
  {
    name: "Especialistas en Sistemas de Sellado",
    logo: getLogo("Especialistas en Sistemas de Sellado.avif"),
  },
  { name: "Geoclub", logo: getLogo("Geoclub.avif") },
  {
    name: "International Clean",
    logo: getLogo("International Clean.avif"),
  },
  { name: "IR Diensa", logo: getLogo("IR Diensa.avif") },
  {
    name: "Refrigerantes Tlanepantla",
    logo: getLogo("RefrigerantesTlanepantla.avif"),
  },
  {
    name: "Regiretantes Cuautitlan",
    logo: getLogo("RegiretantesCuautitlan.avif"),
  },
  { name: "Ricsa", logo: getLogo("Ricsa.avif") },
  { name: "Sygma", logo: getLogo("Sygma.avif") },
];

// Duplicate suppliers for seamless loop
const allSuppliers = [...suppliers, ...suppliers];
---

<section class="py-16 bg-bg overflow-hidden">
  <div class="container mx-auto px-4 mb-10 text-center">
    <h2 class="text-3xl font-bold text-fg mb-4 animate-fade-in-up">
      Nuestros Proveedores Estratégicos
    </h2>
    <p
      class="text-muted max-w-2xl mx-auto animate-fade-in-up animate-delay-200"
    >
      Trabajamos de la mano con los mejores proveedores para garantizar
      refacciones originales y equipos de la más alta calidad en cada proyecto.
    </p>
  </div>

  <div class="relative w-full max-w-screen-2xl mx-auto mask-fade">
    <div class="flex w-max animate-marquee">
      {
        allSuppliers.map((supplier) => (
          <div class="supplier-item flex items-center justify-center mx-4 sm:mx-6 md:mx-8 w-48 sm:w-64 md:w-80 h-24 md:h-32 hover:animate-pulse">
            <Image
              src={supplier.logo}
              alt={supplier.name}
              title={supplier.name}
              class="max-w-full max-h-full object-contain"
            />
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  @keyframes marquee {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }

  .animate-marquee {
    animation: marquee 45s linear infinite;
  }

  .animate-marquee:hover {
    animation-play-state: paused;
  }

  .mask-fade {
    mask-image: linear-gradient(
      to right,
      transparent,
      black 10%,
      black 90%,
      transparent
    );
    -webkit-mask-image: linear-gradient(
      to right,
      transparent,
      black 10%,
      black 90%,
      transparent
    );
  }

  .supplier-item img {
    filter: grayscale(100%);
    opacity: 0.7;
    transition: all 0.3s ease;
  }

  .supplier-item:hover img {
    filter: grayscale(0%);
    opacity: 1;
  }
</style>
