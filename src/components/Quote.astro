---
const formspreeUrl = `https://formspree.io/f/${import.meta.env.PUBLIC_FORMSPREE_QUOTE}`;
---

<section id="cotizar" class="py-24 bg-white relative overflow-hidden">
  <div class="container mx-auto px-4 relative z-10">
    <div class="text-center max-w-3xl mx-auto mb-16 reveal">
      <h2 class="text-blue-600 font-bold uppercase tracking-wider text-sm mb-3">
        Presupuesto sin compromiso
      </h2>
      <h3 class="text-4xl md:text-5xl font-bold text-gray-900 mb-6">
        Solicita tu cotización personalizada
      </h3>
      <p class="text-gray-600 text-lg">
        Completa el siguiente formulario con los detalles de tu requerimiento y
        uno de nuestros expertos se pondrá en contacto contigo para brindarte la
        mejor solución al mejor precio.
      </p>
    </div>

    <div
      class="max-w-4xl mx-auto bg-gray-50 rounded-3xl p-8 md:p-12 border border-gray-100 shadow-xl reveal reveal-delay-200"
    >
      <form
        id="quote-form"
        action={formspreeUrl}
        method="POST"
        class="space-y-8"
      >
        <div class="grid md:grid-cols-2 gap-8">
          <div class="group">
            <label
              for="name"
              class="block text-sm font-bold text-gray-700 mb-2 group-focus-within:text-blue-600 transition-colors"
              >Nombre Completo</label
            >
            <input
              type="text"
              id="name"
              name="name"
              placeholder="Ej. Juan Pérez"
              required
              class="w-full px-6 py-4 rounded-2xl border border-gray-200 focus:border-blue-500 focus:ring-4 focus:ring-blue-100 outline-none transition-all bg-white"
            />
          </div>
          <div class="group">
            <label
              for="email"
              class="block text-sm font-bold text-gray-700 mb-2 group-focus-within:text-blue-600 transition-colors"
              >Correo Electrónico</label
            >
            <input
              type="email"
              id="email"
              name="email"
              placeholder="tu@email.com"
              required
              class="w-full px-6 py-4 rounded-2xl border border-gray-200 focus:border-blue-500 focus:ring-4 focus:ring-blue-100 outline-none transition-all bg-white"
            />
          </div>
        </div>

        <div class="grid md:grid-cols-2 gap-8">
          <div class="group">
            <label
              for="phone"
              class="block text-sm font-bold text-gray-700 mb-2 group-focus-within:text-blue-600 transition-colors"
              >Teléfono / WhatsApp</label
            >
            <input
              type="tel"
              id="phone"
              name="phone"
              placeholder="+1 (555) 000-0000"
              class="w-full px-6 py-4 rounded-2xl border border-gray-200 focus:border-blue-500 focus:ring-4 focus:ring-blue-100 outline-none transition-all bg-white"
            />
          </div>
          <div class="group">
            <label
              for="property-type"
              class="block text-sm font-bold text-gray-700 mb-2 group-focus-within:text-blue-600 transition-colors"
              >Tipo de Inmueble</label
            >
            <select
              id="property-type"
              name="property_type"
              class="w-full px-6 py-4 rounded-2xl border border-gray-200 focus:border-blue-500 focus:ring-4 focus:ring-blue-100 outline-none transition-all appearance-none bg-white"
            >
              <option value="Residencial (Casa/Apto)"
                >Residencial (Casa/Apto)</option
              >
              <option value="Oficina / Local Comercial"
                >Oficina / Local Comercial</option
              >
              <option value="Industrial / Bodega">Industrial / Bodega</option>
              <option value="Otro">Otro</option>
            </select>
          </div>
        </div>

        <div class="group">
          <label
            class="block text-sm font-bold text-gray-700 mb-2 group-focus-within:text-blue-600 transition-colors"
            >¿Qué necesitas?</label
          >
          <div class="grid grid-cols-2 md:grid-cols-3 gap-4">
            {
              [
                {
                  id: "maint",
                  value: "Mantenimiento Preventivo",
                  label: "Mantenimiento Preventivo",
                  icon: '<path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/><path d="m9 12 2 2 4-4"/>',
                },
                {
                  id: "repair",
                  value: "Reparación de Averías",
                  label: "Reparación de Averías",
                  icon: '<path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/>',
                },
                {
                  id: "sales",
                  value: "Venta de Equipos",
                  label: "Venta de Equipos",
                  icon: '<circle cx="8" cy="21" r="1"/><circle cx="19" cy="21" r="1"/><path d="M2.05 2.05h2l2.66 12.42a2 2 0 0 0 2 1.58h9.78a2 2 0 0 0 1.95-1.57l1.65-7.43H5.12"/>',
                },
                {
                  id: "install",
                  value: "Instalación Profesional",
                  label: "Instalación Profesional",
                  icon: '<path d="M8 12h8"/><path d="M12 8v8"/><rect width="18" height="18" x="3" y="3" rx="2"/>',
                },
                {
                  id: "ref",
                  value: "Carga de Refrigerante",
                  label: "Carga de Refrigerante",
                  icon: '<path d="M7 16.3c2.2 0 4-1.8 4-4 0-3.3-4-6.3-4-6.3S3 9 3 12.3c0 2.2 1.8 4 4 4z"/><path d="M17 16.3c2.2 0 4-1.8 4-4 0-3.3-4-6.3-4-6.3S13 9 13 12.3c0 2.2 1.8 4 4 4z"/>',
                },
                {
                  id: "multi",
                  value: "Multiservicios",
                  label: "Multiservicios",
                  icon: '<path d="m12.83 2.18a2 2 0 0 0-1.66 0L2.6 6.08a1 1 0 0 0 0 1.83l8.57 3.91a2 2 0 0 0 1.66 0l8.57-3.9a1 1 0 0 0 0-1.83Z"/><path d="m22 17.65-9.17 4.16a2 2 0 0 1-1.66 0L2 17.65"/><path d="m22 12.65-9.17 4.16a2 2 0 0 1-1.66 0L2 12.65"/>',
                },
              ].map((item) => (
                <label
                  for={item.id}
                  class="relative flex flex-col items-center justify-center p-6 rounded-2xl border-2 border-gray-100 cursor-pointer hover:border-blue-300 hover:bg-blue-50/50 transition-all has-[:checked]:bg-blue-600 has-[:checked]:text-white has-[:checked]:border-blue-600 has-[:checked]:shadow-lg group/card"
                >
                  <input
                    type="checkbox"
                    id={item.id}
                    name="services[]"
                    value={item.value}
                    class="sr-only"
                  />
                  <div
                    class="mb-3 text-blue-500 group-has-[:checked]/card:text-white transition-colors"
                    set:html={`<svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">${item.icon}</svg>`}
                  />
                  <span class="font-bold text-xs text-center">
                    {item.label}
                  </span>
                </label>
              ))
            }
          </div>
        </div>

        <div class="group">
          <label
            for="message"
            class="block text-sm font-bold text-gray-700 mb-2 group-focus-within:text-blue-600 transition-colors"
            >Detalles adicionales</label
          >
          <textarea
            id="message"
            name="message"
            rows="4"
            placeholder="Marca del equipo, síntomas de la falla, número de unidades..."
            class="w-full px-6 py-4 rounded-2xl border border-gray-200 focus:border-blue-500 focus:ring-4 focus:ring-blue-100 outline-none transition-all bg-white"
          ></textarea>
        </div>

        <div
          aria-hidden="true"
          class="absolute opacity-0 h-0 w-0 overflow-hidden"
        >
          <label for="quote-website">No llenar este campo</label>
          <input
            type="text"
            id="quote-website"
            name="_gotcha"
            tabindex="-1"
            autocomplete="off"
          />
        </div>

        <button
          id="quote-submit-button"
          type="submit"
          class="w-full bg-blue-600 text-white font-bold py-5 rounded-2xl hover:bg-blue-700 hover:shadow-2xl hover:shadow-blue-200 transform active:scale-[0.98] transition-all text-lg focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500"
        >
          Enviar Solicitud de Cotización
        </button>
      </form>
    </div>
  </div>
</section>

<script>
  import { sileo } from "sileo";

  function initQuoteForm() {
    const form = document.getElementById(
      "quote-form",
    ) as HTMLFormElement | null;
    const submitButton = document.getElementById(
      "quote-submit-button",
    ) as HTMLButtonElement | null;

    if (!form || !submitButton || form.dataset.bound === "true") return;
    form.dataset.bound = "true";

    async function handleSubmit(event: SubmitEvent) {
      event.preventDefault();

      const nameInput = form!.elements.namedItem("name") as HTMLInputElement;
      const emailInput = form!.elements.namedItem("email") as HTMLInputElement;
      const phoneInput = form!.elements.namedItem("phone") as HTMLInputElement;

      // Validación clara
      if (nameInput.value.trim().length < 3) {
        sileo.error({ title: "Por favor, ingresa tu nombre completo." });
        nameInput.focus();
        return;
      }

      const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
      if (!emailRegex.test(emailInput.value.trim())) {
        sileo.error({
          title: "Por favor, ingresa un correo electrónico válido.",
        });
        emailInput.focus();
        return;
      }

      if (phoneInput.value.trim() !== "") {
        const phoneDigits = phoneInput.value.replace(/\D/g, "");
        if (phoneDigits.length < 10) {
          sileo.error({
            title:
              "Por favor, ingresa un número de teléfono/WhatsApp válido a 10 dígitos.",
          });
          phoneInput.focus();
          return;
        }
      }

      // Validar al menos un servicio seleccionado si es posible, aunque message no es requerido, comprobaremos servicios
      const formData = new FormData(form as HTMLFormElement);
      const services = formData.getAll("services[]");
      const message = formData.get("message") as string;

      if (services.length === 0 && message.trim().length === 0) {
        sileo.error({
          title:
            "Por favor, selecciona qué servicio necesitas o déjanos un detalle en el mensaje.",
        });
        return;
      }

      const originalButtonText = submitButton!.textContent;
      submitButton!.textContent = "Enviando Solicitud...";
      submitButton!.disabled = true;
      submitButton!.classList.add("opacity-70", "cursor-not-allowed");

      const data = new FormData(event.target as HTMLFormElement);

      try {
        const response = await fetch(form!.action, {
          method: form!.method,
          body: data,
          headers: {
            Accept: "application/json",
          },
        });

        if (response.ok) {
          sileo.success({
            title: "¡Solicitud enviada con éxito!",
            description: "Nos comunicaremos contigo a la brevedad.",
          });
          form!.reset();
        } else {
          const resultData = await response.json();
          if (Object.hasOwn(resultData, "errors")) {
            sileo.error({
              title: "Error en el formulario",
              description: resultData.errors
                .map((error: any) => error.message)
                .join(", "),
            });
          } else {
            sileo.error({
              title:
                "Hubo un problema al enviar tu solicitud. Inténtalo de nuevo.",
            });
          }
        }
      } catch (error) {
        sileo.error({
          title:
            "Hubo un error de conexión. Por favor, revisa tu internet y vuelve a intentarlo.",
        });
      } finally {
        submitButton!.textContent = originalButtonText;
        submitButton!.disabled = false;
        submitButton!.classList.remove("opacity-70", "cursor-not-allowed");
      }
    }

    form.addEventListener("submit", handleSubmit);
  }

  document.addEventListener("astro:page-load", initQuoteForm);
  initQuoteForm();
</script>
