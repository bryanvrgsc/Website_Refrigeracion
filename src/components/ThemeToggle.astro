---
const labels = { system: "Sistema", light: "Claro", dark: "Oscuro" };
---

<button
  id="theme-toggle"
  type="button"
  aria-label={`Tema: ${labels.system}`}
  title={`Tema: ${labels.system}`}
  class="fixed bottom-5 right-5 z-50 w-12 h-12 grid place-items-center rounded-full glass text-fg shadow-xl active:scale-95 transition-transform hover:scale-105"
  style="padding-bottom: env(safe-area-inset-bottom, 0);"
>
  <!-- system: monitor -->
  <svg data-icon="system" xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
    <rect x="2" y="3" width="20" height="14" rx="2"></rect><line x1="8" y1="21" x2="16" y2="21"></line><line x1="12" y1="17" x2="12" y2="21"></line>
  </svg>
  <!-- light: sun -->
  <svg data-icon="light" class="hidden" xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
    <circle cx="12" cy="12" r="4"></circle><line x1="12" y1="2" x2="12" y2="4"></line><line x1="12" y1="20" x2="12" y2="22"></line><line x1="4.93" y1="4.93" x2="6.34" y2="6.34"></line><line x1="17.66" y1="17.66" x2="19.07" y2="19.07"></line><line x1="2" y1="12" x2="4" y2="12"></line><line x1="20" y1="12" x2="22" y2="12"></line><line x1="4.93" y1="19.07" x2="6.34" y2="17.66"></line><line x1="17.66" y1="6.34" x2="19.07" y2="4.93"></line>
  </svg>
  <!-- dark: moon -->
  <svg data-icon="dark" class="hidden" xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
    <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
  </svg>
</button>

<script>
  import { getStored, setStored, applyTheme, cycle, type ThemeMode } from "../scripts/theme.ts";

  const labels: Record<ThemeMode, string> = {
    system: "Sistema",
    light: "Claro",
    dark: "Oscuro",
  };

  function render(btn: HTMLElement, mode: ThemeMode) {
    btn.querySelectorAll<HTMLElement>("[data-icon]").forEach((icon) => {
      icon.classList.toggle("hidden", icon.dataset.icon !== mode);
    });
    const text = `Tema: ${labels[mode]}`;
    btn.setAttribute("aria-label", text);
    btn.setAttribute("title", text);
  }

  let docListenerAttached = false;

  function initThemeToggle() {
    if (!docListenerAttached) {
      docListenerAttached = true;
      document.addEventListener("themechange", (e) => {
        const btn = document.getElementById("theme-toggle");
        if (btn) {
          const detail = (e as CustomEvent).detail as { mode: ThemeMode };
          render(btn, detail.mode);
        }
      });
    }

    const btn = document.getElementById("theme-toggle");
    if (!btn || btn.dataset.bound === "true") {
      if (btn) render(btn, getStored());
      return;
    }
    btn.dataset.bound = "true";
    render(btn, getStored());

    btn.addEventListener("click", () => {
      const next = cycle(getStored());
      setStored(next);
      applyTheme(next);
    });
  }

  document.addEventListener("astro:page-load", initThemeToggle);
  initThemeToggle();
</script>
