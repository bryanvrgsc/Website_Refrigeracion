---
const navItems = [
  { name: "Inicio", href: "/" },
  { name: "Sobre Nosotros", href: "/sobre-nosotros" },
  { name: "Servicios", href: "/servicios" },
  { name: "Beneficios", href: "/beneficios" },
  { name: "Contacto", href: "/contacto" },
];
const currentPath = Astro.url.pathname;
const normalize = (path: string) => path.replace(/\/$/, "") || "/";
---

<header
  id="main-header"
  class="fixed w-full top-0 z-50 transition-all duration-300 bg-transparent animate-fade-in-down py-5"
>
  <div class="container mx-auto px-4 flex justify-between items-center">
    <!-- Logo: Solo ícono en móvil, con texto en desktop -->
    <a
      href="/"
      class="font-black text-slate-900 flex items-center gap-2 group tracking-tight"
    >
      <img
        id="brand-logo"
        src="/favicon.svg"
        alt="AC y Multiservicio Industrial"
        width="40"
        height="40"
        loading="eager"
        class="w-10 h-10 group-hover:scale-110 transition-transform duration-300"
      />
      <!-- Texto del logo visible siempre -->
      <span class="flex flex-col leading-tight">
        <span class="text-xs sm:text-sm">Aire Acondicionado y</span>
        <span class="text-blue-600 text-[10px] sm:text-xs">Multiservicio Industrial</span>
      </span>
    </a>

    <!-- Navegación Desktop -->
    <nav
      class="hidden lg:flex gap-1 glass p-1.5 rounded-2xl border-white/40 shadow-xl shadow-slate-200/50"
    >
      {
        navItems.map((item) => (
          <a
            href={item.href}
            class:list={[
              "px-5 py-2.5 rounded-xl font-bold transition-all text-sm tracking-wide whitespace-nowrap",
              normalize(currentPath) === normalize(item.href)
                ? "bg-blue-600 text-white shadow-lg shadow-blue-500/20"
                : "text-slate-600 hover:text-blue-600 hover:bg-blue-50/50",
            ]}
          >
            {item.name}
          </a>
        ))
      }
    </nav>

    <!-- Acciones -->
    <div class="flex items-center gap-3">
      <a
        href="/cotizar"
        class="hidden lg:flex bg-slate-900 text-white px-7 py-2.5 rounded-xl text-sm font-bold hover:bg-blue-600 hover:shadow-xl hover:shadow-blue-500/20 transition-all transform hover:-translate-y-0.5 active:scale-95 whitespace-nowrap items-center justify-center"
      >
        Cotizar Proyecto
      </a>

      <!-- Mobile Menu Button -->
      <button
        id="mobile-menu-btn"
        class="lg:hidden text-slate-900 p-2.5 glass rounded-xl border-white/50 shadow-sm active:scale-95 transition-transform"
        aria-label="Menú de navegación"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          ><line x1="4" x2="20" y1="12" y2="12"></line><line
            x1="4"
            x2="20"
            y1="6"
            y2="6"></line><line x1="4" x2="20" y1="18" y2="18"></line></svg
        >
      </button>
    </div>
  </div>

  <!-- Mobile Menu Dropdown -->
  <div
    id="mobile-menu"
    class="lg:hidden absolute top-full left-0 w-full bg-white border-t border-gray-100 shadow-xl overflow-hidden transition-all duration-300 max-h-0 opacity-0"
  >
    <div class="flex flex-col p-4 gap-2">
      {
        navItems.map((item) => (
          <a
            href={item.href}
            class:list={[
              "px-4 py-3 rounded-xl font-medium transition-colors",
              normalize(currentPath) === normalize(item.href)
                ? "bg-blue-50 text-blue-600"
                : "text-gray-600 hover:bg-gray-50",
            ]}
          >
            {item.name}
          </a>
        ))
      }
      <div class="h-px bg-gray-100 my-2"></div>
      <a
        href="/cotizar"
        class="bg-blue-600 text-white px-4 py-3 rounded-xl font-bold text-center hover:bg-blue-700 transition-colors"
      >
        Cotizar Ahora
      </a>
    </div>
  </div>
</header>

<script>
  declare global {
    interface Window {
      __syncHeaderState?: () => void;
      __headerScrollBound?: boolean;
    }
  }

  function syncHeaderState() {
    const header = document.getElementById("main-header");
    if (!header) return;

    if (window.scrollY > 20) {
      header?.classList.add(
        "glass",
        "shadow-xl",
        "!py-3",
        "border-b",
        "border-slate-200/50",
      );
      header?.classList.remove("bg-transparent");
    } else {
      header?.classList.remove(
        "glass",
        "shadow-xl",
        "!py-3",
        "border-b",
        "border-slate-200/50",
      );
      header?.classList.add("bg-transparent");
    }
  }

  function initHeader() {
    const mobileBtn = document.getElementById("mobile-menu-btn");
    const mobileMenu = document.getElementById("mobile-menu");

    if (mobileBtn && mobileMenu && mobileBtn.dataset.bound !== "true") {
      mobileBtn.dataset.bound = "true";

      const closeMenu = () => {
        mobileMenu.classList.add("max-h-0", "opacity-0");
        mobileMenu.classList.remove("max-h-96", "opacity-100");
      };

      mobileBtn.addEventListener("click", () => {
        const isOpen = mobileMenu.classList.contains("max-h-96");

        if (isOpen) {
          closeMenu();
        } else {
          mobileMenu.classList.remove("max-h-0", "opacity-0");
          mobileMenu.classList.add("max-h-96", "opacity-100");
        }
      });

      mobileMenu.querySelectorAll("a").forEach((link) => {
        link.addEventListener("click", closeMenu);
      });
    }

    syncHeaderState();
  }

  if (!window.__headerScrollBound) {
    window.__headerScrollBound = true;
    window.__syncHeaderState = syncHeaderState;
    window.addEventListener("scroll", () => {
      window.__syncHeaderState?.();
    });
  } else {
    window.__syncHeaderState = syncHeaderState;
  }

  document.addEventListener("astro:page-load", initHeader);
  initHeader();
</script>
