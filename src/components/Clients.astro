---
import { Image } from "astro:assets";

const clientLogos = import.meta.glob<{ default: ImageMetadata }>(
    "/src/assets/images/clients/*.{avif,webp,png,jpg,jpeg}",
    { eager: true },
);
const getLogo = (name: string) =>
    clientLogos[`/src/assets/images/clients/${name}`].default;

const clients = [
    {
        name: "Argo Artes Gráficas",
        logo: getLogo("ArgoArtesGraficas.avif"),
    },
    {
        name: "Active Vision Center",
        logo: getLogo("ActiveVisionCenter.avif"),
    },
    { name: "CCL", logo: getLogo("CCL.avif") },
    {
        name: "Colegio San Ildefonso",
        logo: getLogo("ColegioSanIldefonso.avif"),
    },
    { name: "Filoyarn", logo: getLogo("Filoyarn.avif") },
    { name: "GP Impresores", logo: getLogo("GPImpresores.avif") },
    { name: "Grupo Zapata", logo: getLogo("GrupoZapata.avif") },
    { name: "Industrias Cazel", logo: getLogo("IndustriasCazel.webp") },
    { name: "RR Donnelley", logo: getLogo("RRDonnelley.avif") },
    { name: "Tlapa", logo: getLogo("Tlapa.avif") },
    { name: "VetcoGray", logo: getLogo("VetcoGray.avif") },
    { name: "Vidimport", logo: getLogo("Vidimport.avif") },
];
---

<section class="py-24 bg-white overflow-hidden">
    <div class="container mx-auto px-4 text-center">
        <div class="max-w-3xl mx-auto mb-16">
            <h2
                class="text-blue-600 font-bold uppercase tracking-wider text-sm mb-3 animate-fade-in-down"
            >
                CONFIANZA Y RESULTADOS
            </h2>
            <h3
                class="text-4xl font-bold text-gray-900 mb-6 italic animate-fade-in-up animate-delay-200"
            >
                Empresas que confían en nosotros
            </h3>
            <div
                class="w-20 h-1.5 bg-blue-600 mx-auto rounded-full mb-8 animate-expand-horizontally animate-delay-300"
            >
            </div>
            <p
                class="text-gray-600 text-lg animate-fade-in-up animate-delay-400"
            >
                Colaboramos con empresas líderes en diversos sectores,
                garantizando sistemas de climatización y servicios industriales
                de la más alta calidad.
            </p>
        </div>

        <div
            class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-8 md:gap-12 items-center justify-items-center"
        >
            {
                clients.map((client, index) => (
                    <div
                        class={`group relative flex items-center justify-center p-6 grayscale hover:grayscale-0 opacity-60 hover:opacity-100 transition-all duration-500 bg-gray-50/50 rounded-2xl border border-transparent hover:border-gray-100 hover:bg-white hover:shadow-xl hover:shadow-blue-500/5 animate-fade-in-up animate-delay-${index * 100}`}
                    >
                        <Image
                            src={client.logo}
                            alt={client.name}
                            class="max-h-16 w-auto object-contain transform group-hover:scale-110 transition-transform duration-500"
                        />
                        <span class="absolute -bottom-10 opacity-0 group-hover:opacity-100 transition-opacity duration-300 text-sm font-semibold text-blue-600 whitespace-nowrap">
                            {client.name}
                        </span>
                    </div>
                ))
            }
        </div>
    </div>
</section>

<style>
    .reveal {
        opacity: 0;
        transform: translateY(20px);
        transition: all 0.8s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .reveal.active {
        opacity: 1;
        transform: translateY(0);
    }
</style>

<script>
    const observerOptions = {
        root: null,
        rootMargin: "0px",
        threshold: 0.1,
    };

    const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
            if (entry.isIntersecting) {
                entry.target.classList.add("active");
            }
        });
    }, observerOptions);

    document.addEventListener("DOMContentLoaded", () => {
        document
            .querySelectorAll(".reveal")
            .forEach((el) => observer.observe(el));
    });
</script>
