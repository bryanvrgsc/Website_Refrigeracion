---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import Brands from "../components/Brands.astro";
import Footer from "../components/Footer.astro";
---

<Layout
  title="AC y Multiservicio Industrial | Expertos en Climatización"
  description="Expertos en instalación, mantenimiento y reparación de aire acondicionado y refrigeración industrial. Servicio técnico certificado y garantizado."
>
  <Header />
  <main>
    <Hero />

    <!-- Brief Introduction / Teaser -->
    <section class="py-20 bg-bg">
      <div class="container mx-auto px-4 text-center max-w-3xl">
        <h2 class="text-3xl font-bold text-fg mb-6">
          Expertos en Climatización para tu Hogar y Negocio
        </h2>
        <p
          class="text-muted text-lg mb-10 leading-relaxed reveal reveal-delay-100"
        >
          En Aire Acondicionado y Multiservicio Industrial nos dedicamos a
          garantizar el máximo confort en tus espacios. Contamos con un equipo
          de profesionales certificados listos para atender cualquier necesidad,
          desde mantenimientos rutinarios hasta instalaciones complejas.
        </p>
        <div class="flex justify-center gap-6 reveal reveal-delay-200">
          <a
            href="/beneficios"
            class="text-blue-600 font-bold hover:underline underline-offset-4 flex items-center gap-2"
          >
            Nuestra Garantía
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              ><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg
            >
          </a>
        </div>
      </div>
    </section>

    <Brands />

    <!-- Final Call to Action -->
    <section class="py-24 bg-blue-50 dark:bg-blue-950/30">
      <div class="container mx-auto px-4 text-center">
        <h2 class="text-4xl font-bold text-fg mb-6 reveal">
          ¿Tu aire acondicionado necesita atención?
        </h2>
        <p class="text-xl text-muted mb-10 reveal reveal-delay-100">
          No esperes a que falle. Agenda una revisión hoy mismo y ahorra dinero.
        </p>
        <a
          href="/cotizar"
          class="inline-block bg-blue-600 text-white px-10 py-4 rounded-xl font-bold text-xl hover:bg-blue-700 transition-all shadow-xl shadow-blue-200 hover:-translate-y-1 reveal reveal-delay-200"
        >
          Solicitar Presupuesto Gratis
        </a>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
